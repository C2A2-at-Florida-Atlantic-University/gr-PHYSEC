options:
  parameters:
    author: Bob Node
    catch_exceptions: 'True'
    category: '[PHYSEC]'
    cmake_opt: ''
    comment: Bob protocol node with messaging triggers (ZeroMQ) and PlutoSDR
    copyright: ''
    description: Bob full-node skeleton in YAML GRC format (GR 3.10)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: bob_node_protocol
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Bob Protocol Node - PHYSEC
    window_size: (1200,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: monitor_addr
  id: variable
  parameters:
    comment: ZeroMQ address for status out
    value: '"tcp://127.0.0.1:9101"'
