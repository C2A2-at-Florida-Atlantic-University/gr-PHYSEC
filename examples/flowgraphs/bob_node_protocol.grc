    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: '2442000000'
    fstop: '0'
    len_tag_key: packet_len
    samplerate: sample_rate
    type: fc32
    uri: sdr_uri
  states:
    bus_sink: false
