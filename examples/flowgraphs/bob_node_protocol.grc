    fpass: '0'
    frequency: '2442000000'
    fstop: '0'
    gain1: '''slow_attack'''
    len_tag_key: packet_len
    manual_gain1: '64'
    maxoutbuf: '0'
    minoutbuf: '0'
    quadrature: 'True'
    rfdc: 'True'
    samplerate: sample_rate
    type: fc32
    uri: sdr_uri
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [96, 176]
    rotation: 0
