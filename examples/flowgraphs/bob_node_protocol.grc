    num_items: vector_size
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 176]
    rotation: 0
    state: enabled
- name: blocks_stream_to_vector_1
  id: blocks_stream_to_vector
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: parity_len
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1512, 368.0]
    rotation: 0
    state: true
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self):\n        gr.basic_block.__init__(self, name='Bob Controller',\
      \ in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('msg_in'))\n\
      \        self.message_port_register_out(pmt.intern('tx_mute'))\n        self.message_port_register_out(pmt.intern('out'))\n\
      \        self.set_msg_handler(pmt.intern('msg_in'), self.handle_ctrl)\n\n  \
      \  def handle_ctrl(self, msg):\n        try:\n            val = pmt.symbol_to_string(msg)\
      \ if pmt.is_symbol(msg) else str(pmt.to_python(msg))\n        except Exception:\n\
      \            val = 'unknown'\n        if 'start_tx' in val:\n            self.message_port_pub(pmt.intern('tx_mute'),\
      \ pmt.to_pmt(False))\n            self.message_port_pub(pmt.intern('out'), pmt.intern('bob_start_tx'))\n\
      \        elif 'stop_tx' in val:\n            self.message_port_pub(pmt.intern('tx_mute'),\
      \ pmt.to_pmt(True))\n            self.message_port_pub(pmt.intern('out'), pmt.intern('bob_stop_tx'))\n\
      \        elif 'collect' in val:\n            self.message_port_pub(pmt.intern('out'),\
      \ pmt.intern('bob_collecting'))\n        elif 'parity_recv' in val:\n      \
      \      self.message_port_pub(pmt.intern('out'), pmt.intern('bob_parity_recv'))\n\
      \        elif 'reconcile_ok' in val:\n            self.message_port_pub(pmt.intern('out'),\
      \ pmt.intern('bob_reconcile_ok'))\n        elif 'reconcile_fail' in val:\n \
      \           self.message_port_pub(pmt.intern('out'), pmt.intern('bob_reconcile_fail'))\n\
      \        elif 'privacy_done' in val:\n            self.message_port_pub(pmt.intern('out'),\
      \ pmt.intern('bob_privacy_done'))\n        else:\n            self.message_port_pub(pmt.intern('out'),\
      \ pmt.intern('bob_unknown'))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Bob Controller', 'blk', [], [('msg_in', 'message', 1)], [('out',
      'message', 1), ('tx_mute', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 416.0]
    rotation: 0
    state: enabled
- name: iio_pluto_sink_0
  id: iio_pluto_sink
