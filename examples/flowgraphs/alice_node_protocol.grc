- name: epy_block_push_spec
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport numpy as np, socket, json, time,\
      \ threading, os\n\nclass blk(gr.sync_block):\n    def __init__(self, node_name=\"\
      Alice\"):\n        gr.sync_block.__init__(self, name='Monitor Push Spectrogram',\
      \ in_sig=[(np.float32, (6324))], out_sig=None)\n        self.node_name = node_name\n\
      \        self.host = os.getenv('MONITOR_HOST', '192.168.0.142')\n        self.port\
      \ = int(os.getenv('MONITOR_PORT', '9999'))\n        self.sock = None\n     \
      \   self._lock = threading.Lock()\n        self._connect()\n\n    def _connect(self):\n\
      \        try:\n            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n\
      \            s.settimeout(2.0)\n            s.connect((self.host, self.port))\n\
      \            s.settimeout(None)\n            self.sock = s\n        except Exception:\n\
      \            self.sock = None\n\n    def _send(self, payload):\n        try:\n\
      \            if self.sock is None:\n                self._connect()\n      \
      \      if self.sock:\n                data = (json.dumps(payload) + \"\\n\"\
      ).encode('utf-8')\n                with self._lock:\n                    self.sock.sendall(data)\n\
      \        except Exception:\n            self.sock = None\n\n    def work(self,\
      \ input_items, output_items):\n        specs = input_items[0]\n        for spec\
      \ in specs:\n            try:\n                data_list = spec.tolist() if\
      \ hasattr(spec, 'tolist') else [list(row) for row in spec]\n               \
      \ payload = {\"type\": \"data_push\", \"data_type\": \"spectrogram\", \"node_name\"\
      : self.node_name, \"data\": data_list, \"timestamp\": time.time()}\n       \
      \         self._send(payload)\n            except Exception:\n             \
      \   pass\n        return len(specs)\n"
    affinity: ''
    alias: ''
    comment: Push spectrograms to monitor
    maxoutbuf: '0'
    minoutbuf: '0'
    node_name: '"Alice"'
  states:
    _io_cache: ('Monitor Push Spectrogram', 'blk', [('node_name', "'Alice'")], [('0',
      'float', 6324)], [], '', ['node_name'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [944, 108.0]
    rotation: 0
    state: enabled
- name: epy_block_rx_gate
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport numpy as np, pmt\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, num_items=8192):\n        gr.sync_block.__init__(self,\
      \ name='RX Gate', in_sig=[np.complex64], out_sig=[np.complex64])\n        self.num_items\
      \ = int(num_items); self.enabled = False; self.count = 0\n        self.message_port_register_in(pmt.intern('ctrl'))\n\
      \        self.message_port_register_out(pmt.intern('evt'))\n        self.set_msg_handler(pmt.intern('ctrl'),\
      \ self._on_ctrl)\n    def _on_ctrl(self, msg):\n        val = pmt.symbol_to_string(msg)\
      \ if pmt.is_symbol(msg) else str(pmt.to_python(msg))\n        if val == 'start':\
      \ self.enabled = True; self.count = 0\n    def work(self, ins, outs):\n    \
      \    if not self.enabled: return 0\n        n = min(len(ins[0]), len(outs[0]),\
      \ self.num_items - self.count)\n        outs[0][:n] = ins[0][:n]; self.count\
      \ += n\n        if self.count >= self.num_items:\n            self.enabled =\
      \ False\n            self.message_port_pub(pmt.intern('evt'), pmt.intern('rx_collected'))\n\
      \        return n\n"
    affinity: ''
    alias: ''
    comment: Message-gated RX pass-through of N items
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: vector_size
  states:
    _io_cache: ('RX Gate', 'blk', [('num_items', '8192')], [('0', 'complex', 1), ('ctrl',
      'message', 1)], [('0', 'complex', 1), ('evt', 'message', 1)], '', ['num_items'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 192.0]
    rotation: 0
    state: enabled
