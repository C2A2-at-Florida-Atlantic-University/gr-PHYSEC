- name: epy_block_ctrl
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport pmt\n\nclass blk(gr.basic_block):\n\
      \    def __init__(self):\n        gr.basic_block.__init__(self, name='Alice\
      \ Controller', in_sig=None, out_sig=None)\n        self.message_port_register_in(pmt.intern('msg_in'))\n\
      \        self.message_port_register_in(pmt.intern('evt_in'))\n        self.message_port_register_out(pmt.intern('tx_mute'))\n\
      \        self.message_port_register_out(pmt.intern('out'))\n        self.message_port_register_out(pmt.intern('peer'))\n\
      \        self.message_port_register_out(pmt.intern('rx_ctrl'))\n        self.set_msg_handler(pmt.intern('msg_in'),\
      \ self.handle_msg)\n        self.set_msg_handler(pmt.intern('evt_in'), self.handle_evt)\n\
      \        self.message_port_pub(pmt.intern('tx_mute'), pmt.to_pmt(True))\n  \
      \      self.state = 'idle'\n    def handle_msg(self, msg):\n        val = pmt.symbol_to_string(msg)\
      \ if pmt.is_symbol(msg) else str(pmt.to_python(msg))\n        if val == 'probe_req'\
      \ and self.state == 'idle':\n            self.message_port_pub(pmt.intern('out'),\
      \ pmt.intern('alice_accept'))\n            self.message_port_pub(pmt.intern('rx_ctrl'),\
      \ pmt.intern('start'))\n            self.state = 'collecting'\n        elif\
      \ val == 'bob_collect_done' and self.state == 'txing':\n            self.message_port_pub(pmt.intern('tx_mute'),\
      \ pmt.to_pmt(True))\n            self.message_port_pub(pmt.intern('out'), pmt.intern('alice_tx_stop'))\n\
      \            self.state = 'processing'\n        elif val in ('reconcile_ok','reconcile_fail'):\n\
      \            self.message_port_pub(pmt.intern('out'), pmt.intern('alice_'+val))\n\
      \        else:\n            self.message_port_pub(pmt.intern('out'), pmt.intern('alice_evt_'+val))\n\
      \    def handle_evt(self, msg):\n        val = pmt.symbol_to_string(msg) if\
      \ pmt.is_symbol(msg) else str(pmt.to_python(msg))\n        if val == 'rx_collected'\
      \ and self.state == 'collecting':\n            self.message_port_pub(pmt.intern('tx_mute'),\
      \ pmt.to_pmt(False))\n            self.message_port_pub(pmt.intern('peer'),\
      \ pmt.intern('alice_tx_start'))\n            self.message_port_pub(pmt.intern('out'),\
      \ pmt.intern('alice_tx_start'))\n            self.state = 'txing'\n"
    affinity: ''
    alias: ''
    comment: Alice handshake controller
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Alice Controller', 'blk', [], [('evt_in', 'message', 1), ('msg_in',
      'message', 1)], [('rx_ctrl', 'message', 1), ('peer', 'message', 1), ('out',
      'message', 1), ('tx_mute', 'message', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [400, 464.0]
    rotation: 0
    state: enabled
- name: epy_block_rx_gate
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport numpy as np, pmt\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, num_items=8192):\n        gr.sync_block.__init__(self,\
      \ name='RX Gate', in_sig=[np.complex64], out_sig=[np.complex64])\n        self.num_items\
      \ = int(num_items); self.enabled = False; self.count = 0\n        self.message_port_register_in(pmt.intern('ctrl'))\n\
      \        self.message_port_register_out(pmt.intern('evt'))\n        self.set_msg_handler(pmt.intern('ctrl'),\
      \ self._on_ctrl)\n    def _on_ctrl(self, msg):\n        val = pmt.symbol_to_string(msg)\
      \ if pmt.is_symbol(msg) else str(pmt.to_python(msg))\n        if val == 'start':\
      \ self.enabled = True; self.count = 0\n    def work(self, ins, outs):\n    \
      \    if not self.enabled: return 0\n        n = min(len(ins[0]), len(outs[0]),\
      \ self.num_items - self.count)\n        outs[0][:n] = ins[0][:n]; self.count\
      \ += n\n        if self.count >= self.num_items:\n            self.enabled =\
      \ False\n            self.message_port_pub(pmt.intern('evt'), pmt.intern('rx_collected'))\n\
      \        return n\n"
    affinity: ''
    alias: ''
    comment: Message-gated RX pass-through of N items
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: vector_size
  states:
    _io_cache: ('RX Gate', 'blk', [('num_items', '8192')], [('0', 'complex', 1), ('ctrl',
      'message', 1)], [('0', 'complex', 1), ('evt', 'message', 1)], '', ['num_items'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 192.0]
    rotation: 0
    state: enabled
