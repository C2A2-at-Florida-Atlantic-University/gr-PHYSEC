options:
  parameters:
    author: Alice Node
    catch_exceptions: 'True'
    category: '[PHYSEC]'
    cmake_opt: ''
    comment: Alice protocol node with messaging triggers (ZeroMQ) and PlutoSDR
    copyright: ''
    description: Alice full-node skeleton in YAML GRC format (GR 3.10)
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: alice_node_protocol
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'False'
    run_command: env PHYSEC_RX_DELAY_MS=300 {python} -u {filename}
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Alice Protocol Node - PHYSEC
    window_size: (1200,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 12.0]
    rotation: 0
    state: enabled

